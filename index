<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Riordan Alumni Survey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=EB+Garamond:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ucla-blue: #2774AE;
      --deep-navy: #003B5C;
      --gold: #FFD100;
      --sky: #EAF4FB;
      --bg: #F6F9FC;
      --card: #FFFFFF;
      --text: #172033;
      --muted: #687386;
      --line: #DCE6F0;
      --success: #138A5E;
      --error: #C0392B;
      --shadow: 0 18px 45px rgba(0, 59, 92, 0.13);
      --radius-lg: 28px;
      --radius-md: 18px;
      --radius-sm: 12px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: linear-gradient(180deg, #F8FBFD 0%, var(--bg) 100%);
      color: var(--text);
    }

    button, input, textarea { font-family: inherit; }

    .app-shell {
      min-height: 100vh;
      padding-bottom: 92px;
    }

    .progress-wrap {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(246, 249, 252, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(220, 230, 240, 0.8);
    }

    .progress-inner {
      max-width: 760px;
      margin: 0 auto;
      padding: 12px 18px;
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 8px;
      font-weight: 600;
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background: #E2EDF5;
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--ucla-blue), var(--deep-navy));
      border-radius: 999px;
      transition: width 260ms ease;
    }

    .container {
      max-width: 760px;
      margin: 0 auto;
      padding: 22px 18px 0;
    }

    .hero {
      background:
        radial-gradient(circle at top right, rgba(255, 209, 0, 0.22), transparent 34%),
        linear-gradient(135deg, var(--deep-navy), var(--ucla-blue));
      color: white;
      border-radius: 34px;
      padding: 34px 26px;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 50%;
      right: -60px;
      bottom: -80px;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border: 1px solid rgba(255,255,255,0.24);
      border-radius: 999px;
      background: rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.92);
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .eyebrow span {
      width: 8px;
      height: 8px;
      background: var(--gold);
      border-radius: 50%;
      display: inline-block;
    }

    h1 {
      font-family: "EB Garamond", Georgia, serif;
      font-size: clamp(58px, 15vw, 104px);
      line-height: 0.9;
      letter-spacing: -0.04em;
      margin: 0 0 12px;
      max-width: 620px;
    }

    .hero p {
      font-size: 17px;
      line-height: 1.55;
      color: rgba(255,255,255,0.88);
      margin: 0;
      max-width: 620px;
    }

    .hero-details {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 24px;
    }

    .detail-pill {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 16px;
      padding: 12px;
      font-size: 13px;
      font-weight: 700;
      text-align: center;
    }

    form {
      margin-top: 18px;
    }

    .question-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 24px;
      margin: 16px 0;
      box-shadow: 0 12px 36px rgba(0, 59, 92, 0.07);
      transition: border 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .question-card:focus-within {
      border-color: rgba(39, 116, 174, 0.55);
      box-shadow: 0 16px 44px rgba(39, 116, 174, 0.16);
      transform: translateY(-1px);
    }

    .section-label {
      color: var(--ucla-blue);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .question-title {
      font-size: 22px;
      line-height: 1.18;
      margin: 0 0 8px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .question-help {
      color: var(--muted);
      line-height: 1.45;
      font-size: 15px;
      margin: 0 0 18px;
    }

    .optional-tag {
      display: inline-block;
      margin-left: 8px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      background: #EFF5F9;
      border-radius: 999px;
      padding: 4px 8px;
      vertical-align: middle;
    }

    .choice-grid {
      display: grid;
      gap: 10px;
    }

    .choice-card {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      min-height: 58px;
      padding: 15px 15px;
      border: 1.5px solid var(--line);
      border-radius: var(--radius-md);
      background: #FFFFFF;
      cursor: pointer;
      transition: all 160ms ease;
      user-select: none;
    }

    .choice-card:hover {
      border-color: rgba(39, 116, 174, 0.55);
      background: #F9FCFE;
    }

    .choice-card input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .fake-control {
      flex: 0 0 auto;
      width: 23px;
      height: 23px;
      border: 2px solid #AFC4D4;
      border-radius: 7px;
      margin-top: 1px;
      display: grid;
      place-items: center;
      transition: all 160ms ease;
    }

    .radio .fake-control { border-radius: 50%; }

    .fake-control::after {
      content: "";
      width: 11px;
      height: 11px;
      transform: scale(0);
      background: white;
      border-radius: 3px;
      transition: transform 160ms ease;
    }

    .radio .fake-control::after { border-radius: 50%; }

    .choice-card input:checked ~ .fake-control {
      background: var(--ucla-blue);
      border-color: var(--ucla-blue);
    }

    .choice-card input:checked ~ .fake-control::after { transform: scale(1); }

    .choice-card:has(input:checked) {
      border-color: var(--ucla-blue);
      background: linear-gradient(180deg, #F2F9FF, #FFFFFF);
      box-shadow: 0 10px 24px rgba(39, 116, 174, 0.12);
    }

    .choice-text strong {
      display: block;
      font-size: 16px;
      margin-bottom: 2px;
    }

    .choice-text span {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.35;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .chip {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 46px;
      padding: 12px 15px;
      border: 1.5px solid var(--line);
      border-radius: 999px;
      background: white;
      color: var(--text);
      font-weight: 700;
      cursor: pointer;
      transition: all 160ms ease;
      user-select: none;
    }

    .chip input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .chip:has(input:checked) {
      background: var(--ucla-blue);
      color: white;
      border-color: var(--ucla-blue);
      box-shadow: 0 8px 20px rgba(39, 116, 174, 0.22);
    }

    .chip.disabled {
      opacity: 0.46;
      cursor: not-allowed;
    }

    .counter {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
      background: #EFF5F9;
      padding: 7px 10px;
      border-radius: 999px;
      margin: 0 0 14px;
    }

    .counter.good { color: var(--success); }

    .field-grid {
      display: grid;
      gap: 12px;
    }

    .field {
      display: grid;
      gap: 7px;
    }

    label.field-label {
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    input[type="text"], input[type="email"], input[type="tel"], input[type="url"], input[type="number"], textarea {
      width: 100%;
      border: 1.5px solid var(--line);
      border-radius: 15px;
      background: #FBFDFF;
      padding: 15px 14px;
      font-size: 16px;
      color: var(--text);
      outline: none;
      transition: all 160ms ease;
    }

    textarea {
      min-height: 130px;
      resize: vertical;
      line-height: 1.45;
    }

    input:focus, textarea:focus {
      border-color: var(--ucla-blue);
      box-shadow: 0 0 0 4px rgba(39, 116, 174, 0.12);
      background: white;
    }

    input.is-valid {
      border-color: var(--success);
      background: #F7FCFA;
    }

    input.is-invalid {
      border-color: var(--error);
      background: #FFF8F7;
    }

    .field-hint {
      font-size: 12px;
      line-height: 1.35;
      color: var(--muted);
      font-weight: 700;
      min-height: 16px;
    }

    .field-hint.valid { color: var(--success); }

    .field-hint.invalid { color: var(--error); }

    .contact-fields {
      display: none;
      margin-top: 14px;
      border-top: 1px solid var(--line);
      padding-top: 16px;
    }

    .contact-fields.show { display: grid; }

    .slider-wrap {
      background: #F8FBFE;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      padding: 18px;
    }

    .slider-value {
      text-align: center;
      font-size: 18px;
      font-weight: 900;
      color: var(--deep-navy);
      margin-bottom: 14px;
    }

    input[type="range"] {
      width: 100%;
      accent-color: var(--ucla-blue);
      margin: 10px 0 14px;
    }

    .range-labels {
      display: flex;
      justify-content: space-between;
      gap: 6px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      text-align: center;
    }

    .range-labels span { flex: 1; }

    .privacy-note {
      display: flex;
      gap: 10px;
      background: var(--sky);
      color: var(--deep-navy);
      border: 1px solid #CFE4F2;
      border-radius: 16px;
      padding: 13px;
      font-size: 14px;
      line-height: 1.35;
      margin-top: 14px;
    }

    .actions-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 25;
      background: rgba(255,255,255,0.94);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--line);
      padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
    }

    .actions-inner {
      max-width: 760px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .submit-btn {
      width: 100%;
      border: 0;
      border-radius: 18px;
      min-height: 56px;
      background: linear-gradient(135deg, var(--ucla-blue), var(--deep-navy));
      color: white;
      font-size: 17px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 12px 28px rgba(39, 116, 174, 0.28);
      transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .submit-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 34px rgba(39, 116, 174, 0.36);
    }

    .submit-btn:disabled {
      opacity: 0.62;
      cursor: not-allowed;
      transform: none;
    }

    .form-message {
      display: none;
      border-radius: 16px;
      padding: 14px;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.35;
      margin: 16px 0;
    }

    .form-message.error {
      display: block;
      color: var(--error);
      background: #FDEDEC;
      border: 1px solid #F5B7B1;
    }

    .form-message.success {
      display: block;
      color: var(--success);
      background: #EAF8F2;
      border: 1px solid #B8E6D0;
    }

    .success-screen {
      display: none;
      background: white;
      border: 1px solid var(--line);
      border-radius: 34px;
      padding: 34px 24px;
      margin: 18px 0;
      text-align: center;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .confetti-wrap {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .confetti-piece {
      position: absolute;
      top: -20px;
      width: 8px;
      height: 14px;
      border-radius: 3px;
      opacity: 0.9;
      animation: confettiFall 1800ms ease-out forwards;
    }

    @keyframes confettiFall {
      0% {
        transform: translateY(-20px) rotate(0deg);
        opacity: 0;
      }
      12% { opacity: 0.9; }
      100% {
        transform: translateY(360px) rotate(260deg);
        opacity: 0;
      }
    }

    .success-screen.show { display: block; }

    .success-icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #EAF8F2;
      color: var(--success);
      margin: 0 auto 16px;
      font-size: 30px;
      font-weight: 900;
    }

    .success-screen h2 {
      font-family: "EB Garamond", Georgia, serif;
      font-size: 42px;
      line-height: 0.95;
      margin: 0 0 10px;
      color: var(--deep-navy);
    }

    .success-screen p {
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }

    .success-links {
      display: grid;
      gap: 12px;
      margin-top: 24px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }

    .success-links a {
      color: var(--deep-navy);
      font-weight: 800;
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 13px 14px;
      background: #F8FBFE;
      transition: all 160ms ease;
    }

    .success-links a:hover {
      border-color: var(--ucla-blue);
      color: var(--ucla-blue);
      background: #FFFFFF;
    }

    .social-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
    }

    .social-links a {
      color: var(--ucla-blue);
      font-weight: 700;
      font-size: 13px;
      text-decoration: none;
      background: var(--sky);
      border: 1px solid #CFE4F2;
      border-radius: 999px;
      padding: 9px 12px;
    }

    .hide { display: none !important; }

    @media (max-width: 620px) {
      .container { padding: 16px 14px 0; }
      .hero { border-radius: 28px; padding: 28px 20px; }
      .hero-details { grid-template-columns: 1fr; }
      .question-card { padding: 20px; border-radius: 24px; }
      .question-title { font-size: 20px; }
      .chips { gap: 9px; }
      .chip { width: 100%; justify-content: center; border-radius: 16px; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <div class="progress-wrap">
      <div class="progress-inner">
        <div class="progress-meta">
          <span id="progressText">0% complete</span>
          <span>Riordan Programs Alumni Survey</span>
        </div>
        <div class="progress-track" aria-hidden="true">
          <div class="progress-bar" id="progressBar"></div>
        </div>
      </div>
    </div>

    <main class="container">
      <section class="hero" id="intro">
        <div class="eyebrow"><span></span> Riordan Programs Alumni Annual Survey</div>
        <h1>40 years.<br>Just getting started.</h1>
        <p>
          As Riordan Programs approaches its 40th Anniversary in 2027, we’re reimagining the alumni community through stronger connections, more relevant programming, and the shared ambition that first brought us together.
        </p>
        <p style="margin-top: 18px; font-size: 16px; color: rgba(255,255,255,0.9);">
          We’d be grateful for a few minutes of your time to provide feedback that will help shape the future of this community.
        </p>

        <div class="hero-details" aria-label="Survey details">
          <div class="detail-pill">⏱ 3 mins. Nothing too heavy to think about.</div>
          <div class="detail-pill">📱 Mobile friendly. Just a few taps is all it takes.</div>
          <div class="detail-pill">🔒 For Riordan Programs use only</div>
        </div>
      </section>

      <form id="surveyForm" novalidate>
        <!-- Replace the action URL below if using Formspree, Basin, Apps Script, or another backend. -->
        <!-- <form action="YOUR_ENDPOINT_HERE" method="POST"> -->

        <div id="formMessage" class="form-message" role="alert"></div>

        <section class="question-card" data-question="program">
          <div class="section-label">About you</div>
          <h2 class="question-title">Which Riordan program were you part of?</h2>
          <p class="question-help">Select all that apply.</p>
          <div class="choice-grid">
            <label class="choice-card">
              <input type="checkbox" name="program" value="Fellows" required>
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Fellows</strong></span>
            </label>
            <label class="choice-card">
              <input type="checkbox" name="program" value="Scholars">
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Scholars</strong></span>
            </label>
            <label class="choice-card">
              <input type="checkbox" name="program" value="College-to-Career">
              <span class="fake-control"></span>
              <span class="choice-text"><strong>College-to-Career</strong></span>
            </label>
            <label class="choice-card">
              <input type="checkbox" name="program" value="Other Affiliation" id="otherAffiliationCheckbox">
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Other Affiliation</strong><span>Please specify your connection to Riordan Programs.</span></span>
            </label>
          </div>
          <div class="field" style="margin-top: 14px; display: none;" id="otherAffiliationFieldWrap">
            <label class="field-label" for="otherAffiliationField">Other affiliation</label>
            <input id="otherAffiliationField" name="other_affiliation" type="text" placeholder="Please specify">
          </div>
        </section>

        <section class="question-card" data-question="year">
          <div class="section-label">About you</div>
          <h2 class="question-title">Graduation or completion year</h2>
          <p class="question-help">Approximate is okay. If you were part of multiple programs, list multiple years.</p>
          <div class="field">
            <label class="field-label" for="completionYear">Year or years</label>
            <input id="completionYear" name="completion_year" type="text" inputmode="numeric" placeholder="Example: 2018 or 2018, 2020" required>
          </div>
        </section>

        <section class="question-card" data-question="connection">
          <div class="section-label">Connection</div>
          <h2 class="question-title">How connected do you feel to the Riordan alumni community right now?</h2>
          <p class="question-help">Pick the statement that feels most true today.</p>
          <div class="choice-grid">
            <label class="choice-card radio">
              <input type="radio" name="connection_level" value="Very connected" required>
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Very connected</strong><span>I’m already plugged in.</span></span>
            </label>
            <label class="choice-card radio">
              <input type="radio" name="connection_level" value="Somewhat connected">
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Somewhat connected</strong><span>I engage occasionally.</span></span>
            </label>
            <label class="choice-card radio">
              <input type="radio" name="connection_level" value="Not very connected">
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Not very connected, but I’m open to changing that</strong><span>I’d be interested in reconnecting in the right ways.</span></span>
            </label>
            <label class="choice-card radio">
              <input type="radio" name="connection_level" value="Not connected">
              <span class="fake-control"></span>
              <span class="choice-text"><strong>Not connected</strong><span>And I’m okay with that for right now.</span></span>
            </label>
          </div>
        </section>

        <section class="question-card" data-question="events">
          <div class="section-label">Events</div>
          <h2 class="question-title">What kinds of events or activities excite you most?</h2>
          <p class="question-help">Pick 1 to 3.</p>
          <div class="counter" id="eventsCounter">0 / 3 selected</div>
          <div class="chips" data-limit="3" data-group="eventsCounter">
            <label class="chip"><input type="checkbox" name="event_interests" value="Smaller casual events">Smaller casual events</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Larger scale events (conferences, galas, etc)">Larger scale events</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Virtual / remote-friendly events">Virtual events</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Community volunteering">Volunteering</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Learning or professional development">Professional development</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Outdoor social activities">Outdoor social</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Special venues">Special venues</label>
            <label class="chip"><input type="checkbox" name="event_interests" value="Other">Other</label>
          </div>
          <div class="field" style="margin-top: 14px;">
            <label class="field-label" for="eventOther">Other event idea</label>
            <input id="eventOther" name="event_other" type="text" placeholder="Optional">
          </div>
        </section>

        <section class="question-card" data-question="frequency">
          <div class="section-label">Participation</div>
          <h2 class="question-title">How often could you realistically participate?</h2>
          <p class="question-help">In an ideal scenario, what level would you like to be involved?</p>
          <div class="slider-wrap">
            <div class="slider-value" id="frequencyText">Move the slider to choose</div>
            <input type="range" id="frequencyRange" name="participation_frequency_score" min="0" max="6" step="1" value="0" aria-label="Participation frequency">
            <input type="hidden" id="frequencyLabel" name="participation_frequency" value="">
