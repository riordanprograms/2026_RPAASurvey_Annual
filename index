  <script>
    const form = document.getElementById('surveyForm');
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');
    const formMessage = document.getElementById('formMessage');
    const successScreen = document.getElementById('successScreen');
    const actionsBar = document.getElementById('actionsBar');
    const submitButton = document.getElementById('submitButton');

    /*
      GOOGLE SHEETS ENDPOINT
      Replace this once your Google Apps Script web app is deployed.
      Partial responses and final submissions will both be sent here.
    */
    const GOOGLE_SHEETS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbzg24-utIQ03HeypDEjjprhtkB3kJaBXv3kE7WAyjGVjxlhRliQr2jzDX-6HfDiAd327A/exec';

    /*
      PARTIAL RESPONSE SETTINGS
      This saves progress after the visitor makes changes, even if they never click submit.
      For privacy, keep the survey intro/privacy language clear that responses may be saved as the form is completed.
    */
    const ENABLE_PARTIAL_RESPONSE_CAPTURE = true;
    const PARTIAL_SAVE_DELAY_MS = 1800;

    const frequencyLabels = {
      1: '🚀 As much as possible',
      2: '👌 Multiple times per year',
      3: '👍 When I can',
      4: '👋 1x/year',
      5: '🗓️ Once in a while',
      6: '⛔️ Not now'
    };

    const requiredGroups = [
      { name: 'program', type: 'checkbox' },
      { name: 'completion_year', type: 'input' },
      { name: 'connection_level', type: 'radio' },
      { name: 'event_interests', type: 'checkbox' },
      { name: 'participation_frequency', type: 'input' },
      { name: 'best_reach', type: 'checkbox' },
      { name: 'share_contact_info', type: 'radio' }
    ];

    function createSessionId() {
      const existing = localStorage.getItem('riordanSurveySessionId');
      if (existing) return existing;

      const id = `riordan_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
      localStorage.setItem('riordanSurveySessionId', id);
      return id;
    }

    const surveySessionId = createSessionId();
    const pageLoadedAt = new Date();
    let hasSubmittedFinal = false;
    let hasSavedPartialThisSession = false;
    let partialSaveTimer = null;
    let lastPartialPayloadString = '';
    let lastFocusedQuestion = '';

    document.querySelectorAll('[data-question]').forEach(card => {
      card.addEventListener('focusin', () => {
        lastFocusedQuestion = card.dataset.question || '';
      });
      card.addEventListener('click', () => {
        lastFocusedQuestion = card.dataset.question || '';
      });
    });

    function getQueryParam(name) {
      return new URLSearchParams(window.location.search).get(name) || '';
    }

    function getDeviceType() {
      const width = window.innerWidth || document.documentElement.clientWidth;
      if (width <= 640) return 'mobile';
      if (width <= 1024) return 'tablet';
      return 'desktop';
    }

    function selectedCount(name) {
      return form.querySelectorAll(`input[name="${name}"]:checked`).length;
    }

    function updateProgress() {
      let complete = 0;
      let total = requiredGroups.length;

      requiredGroups.forEach(group => {
        if (group.type === 'input') {
          const field = form.querySelector(`[name="${group.name}"]`);
          if (field && field.value.trim().length > 0) complete += 1;
        } else {
          if (selectedCount(group.name) > 0) complete += 1;
        }
      });

      const percent = Math.round((complete / total) * 100);
      progressBar.style.width = `${percent}%`;
      progressText.textContent = `${percent}% complete`;
      return percent;
    }

    function updateLimitedChips(container) {
      const isUnlimited = container.dataset.unlimited === 'true';
      const limit = Number(container.dataset.limit || 3);
      const counter = document.getElementById(container.dataset.group);
      const checkboxes = Array.from(container.querySelectorAll('input[type="checkbox"]'));
      const checked = checkboxes.filter(input => input.checked).length;

      if (counter) {
        counter.textContent = isUnlimited ? `${checked} selected` : `${checked} / ${limit} selected`;
        counter.classList.toggle('good', checked > 0);
      }

      checkboxes.forEach(input => {
        const label = input.closest('.chip');
        const shouldDisable = !isUnlimited && checked >= limit && !input.checked;
        input.disabled = shouldDisable;
        label.classList.toggle('disabled', shouldDisable);
      });
    }

    document.querySelectorAll('.chips').forEach(container => {
      updateLimitedChips(container);
      container.addEventListener('change', () => updateLimitedChips(container));
    });

    const frequencyRange = document.getElementById('frequencyRange');
    const frequencyText = document.getElementById('frequencyText');
    const frequencyLabel = document.getElementById('frequencyLabel');

    frequencyRange.addEventListener('input', () => {
      const label = frequencyLabels[frequencyRange.value];
      if (label) {
        frequencyText.textContent = label;
        frequencyLabel.value = label;
      } else {
        frequencyText.textContent = 'Move the slider to choose';
        frequencyLabel.value = '';
      }
    });

    const otherAffiliationCheckbox = document.getElementById('otherAffiliationCheckbox');
    const otherAffiliationFieldWrap = document.getElementById('otherAffiliationFieldWrap');

    if (otherAffiliationCheckbox) {
      otherAffiliationCheckbox.addEventListener('change', () => {
        otherAffiliationFieldWrap.style.display = otherAffiliationCheckbox.checked ? 'grid' : 'none';
      });
    }

    const shareYes = document.getElementById('shareYes');
    const shareNo = document.getElementById('shareNo');
    const contactFields = document.getElementById('contactFields');

    [shareYes, shareNo].forEach(input => {
      input.addEventListener('change', () => {
        contactFields.classList.toggle('show', shareYes.checked);
      });
    });

    function getFormDataObject(responseStatus = 'partial') {
      const data = new FormData(form);
      const obj = {};

      for (const [key, value] of data.entries()) {
        if (obj[key]) {
          obj[key] = Array.isArray(obj[key]) ? [...obj[key], value] : [obj[key], value];
        } else {
          obj[key] = value;
        }
      }

      const now = new Date();
      const progressPercent = updateProgress();

      obj.response_status = responseStatus;
      obj.survey_session_id = surveySessionId;
      obj.submitted_at = responseStatus === 'final' ? now.toISOString() : '';
      obj.last_saved_at = now.toISOString();
      obj.page_loaded_at = pageLoadedAt.toISOString();
      obj.time_on_page_seconds = Math.round((now - pageLoadedAt) / 1000);
      obj.progress_percent = progressPercent;
      obj.last_question_touched = lastFocusedQuestion;
      obj.source_campaign = getQueryParam('campaign') || getQueryParam('utm_campaign');
      obj.source_medium = getQueryParam('medium') || getQueryParam('utm_medium');
      obj.source_source = getQueryParam('source') || getQueryParam('utm_source');
      obj.source_content = getQueryParam('content') || getQueryParam('utm_content');
      obj.referrer = document.referrer || '';
      obj.page_url = window.location.href;
      obj.device_type = getDeviceType();
      obj.screen_width = String(window.screen.width || '');
      obj.screen_height = String(window.screen.height || '');
      obj.browser_language = navigator.language || '';
      obj.user_agent = navigator.userAgent || '';

      return obj;
    }

    async function sendToSheets(payload) {
      if (!GOOGLE_SHEETS_ENDPOINT || GOOGLE_SHEETS_ENDPOINT === 'YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL' || GOOGLE_SHEETS_ENDPOINT === 'PASTE_YOUR_NEW_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE') {
        console.log('Google Sheets endpoint not configured. Payload:', payload);
        return;
      }

      await fetch(GOOGLE_SHEETS_ENDPOINT, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
    }

    function hasMeaningfulPartialData() {
      const data = new FormData(form);
      for (const [key, value] of data.entries()) {
        if (String(value || '').trim()) return true;
      }
      return false;
    }

    async function savePartialResponse() {
      if (!ENABLE_PARTIAL_RESPONSE_CAPTURE || hasSubmittedFinal) return;
      if (!hasMeaningfulPartialData()) return;
      if (!GOOGLE_SHEETS_ENDPOINT || GOOGLE_SHEETS_ENDPOINT === 'YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL' || GOOGLE_SHEETS_ENDPOINT === 'PASTE_YOUR_NEW_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE') return;

      const payload = getFormDataObject('partial');
      payload.partial_save_mode = 'single_latest_abandoned_version_only';
      const payloadString = JSON.stringify(payload);

      if (payloadString === lastPartialPayloadString) return;
      lastPartialPayloadString = payloadString;

      try {
        await sendToSheets(payload);
        hasSavedPartialThisSession = true;
      } catch (error) {
        console.warn('Partial response save failed:', error);
      }
    }

    function schedulePartialSave() {
      if (!ENABLE_PARTIAL_RESPONSE_CAPTURE || hasSubmittedFinal) return;
      clearTimeout(partialSaveTimer);
      partialSaveTimer = setTimeout(savePartialResponse, PARTIAL_SAVE_DELAY_MS);
    }

    function validatePatternField(input, hint, isValidFn, emptyMessage, validMessage, invalidMessage) {
      const value = input.value.trim();

      input.classList.remove('is-valid', 'is-invalid');
      hint.classList.remove('valid', 'invalid');

      if (!value) {
        hint.textContent = emptyMessage;
        return true;
      }

      if (isValidFn(value)) {
        input.classList.add('is-valid');
        hint.classList.add('valid');
        hint.textContent = validMessage;
        return true;
      }

      input.classList.add('is-invalid');
      hint.classList.add('invalid');
      hint.textContent = invalidMessage;
      return false;
    }

    function setupFieldValidation() {
      const zipInput = document.getElementById('zipCode');
      const zipHint = document.getElementById('zipHint');
      const phoneInput = document.getElementById('phone');
      const phoneHint = document.getElementById('phoneHint');

      const validateZip = () => validatePatternField(
        zipInput,
        zipHint,
        value => new RegExp('^[0-9]{5}(-[0-9]{4})?$').test(value),
        'Use a 5-digit ZIP code, or ZIP+4 if relevant.',
        'Looks good.',
        'Please use a valid ZIP code, like 10019 or 10019-1234.'
      );

      const validatePhone = () => validatePatternField(
        phoneInput,
        phoneHint,
        value => value.replace(new RegExp('[^0-9]', 'g'), '').length === 10,
        'Optional. Use a 10-digit phone number if you share one.',
        'Looks good.',
        'Please use a 10-digit phone number, like 555-123-4567.'
      );

      if (zipInput && zipHint) {
        zipInput.addEventListener('input', validateZip);
        zipInput.addEventListener('blur', validateZip);
      }

      if (phoneInput && phoneHint) {
        phoneInput.addEventListener('input', validatePhone);
        phoneInput.addEventListener('blur', validatePhone);
      }
    }

    setupFieldValidation();

    form.addEventListener('input', () => {
      updateProgress();
      schedulePartialSave();
    });

    form.addEventListener('change', () => {
      updateProgress();
      schedulePartialSave();
    });

    window.addEventListener('pagehide', () => {
      if (!ENABLE_PARTIAL_RESPONSE_CAPTURE || hasSubmittedFinal) return;
      if (!GOOGLE_SHEETS_ENDPOINT || GOOGLE_SHEETS_ENDPOINT === 'YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL' || GOOGLE_SHEETS_ENDPOINT === 'PASTE_YOUR_NEW_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE') return;

      if (!hasMeaningfulPartialData()) return;
      const payload = getFormDataObject('partial');
      payload.partial_save_mode = 'single_latest_abandoned_version_only';
      const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
      navigator.sendBeacon(GOOGLE_SHEETS_ENDPOINT, blob);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && !hasSubmittedFinal) {
        savePartialResponse();
      }
    });

    updateProgress();

    function launchConfetti() {
      const wrap = document.getElementById('confettiWrap');
      if (!wrap) return;

      wrap.innerHTML = '';
      const colors = ['#2774AE', '#003B5C', '#FFD100', '#EAF4FB'];
      const pieces = 34;

      for (let i = 0; i < pieces; i++) {
        const piece = document.createElement('span');
        piece.className = 'confetti-piece';
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.background = colors[Math.floor(Math.random() * colors.length)];
        piece.style.animationDelay = `${Math.random() * 420}ms`;
        piece.style.animationDuration = `${1300 + Math.random() * 900}ms`;
        piece.style.transform = `rotate(${Math.random() * 180}deg)`;
        wrap.appendChild(piece);
      }

      setTimeout(() => {
        wrap.innerHTML = '';
      }, 2600);
    }

    function validateForm() {
      formMessage.className = 'form-message';
      formMessage.textContent = '';

      if (selectedCount('program') === 0) {
        return 'Please select at least one Riordan program.';
      }

      const completionYear = form.querySelector('[name="completion_year"]').value.trim();
      if (!completionYear) {
        return 'Please enter your graduation or completion year.';
      }

      if (selectedCount('connection_level') === 0) {
        return 'Please select your current connection level.';
      }

      if (selectedCount('event_interests') === 0) {
        return 'Please select at least one event or activity that interests you.';
      }

      const participationValue = form.querySelector('[name="participation_frequency"]').value.trim();
      if (!participationValue) {
        return 'Please select your ideal participation level.';
      }

      if (selectedCount('best_reach') === 0) {
        return 'Please select at least one way we can reach you.';
      }

      if (selectedCount('share_contact_info') === 0) {
        return 'Please let us know whether you’d like to update your contact information.';
      }

      const zipInput = document.getElementById('zipCode');
      const phoneInput = document.getElementById('phone');
      const zipValue = zipInput ? zipInput.value.trim() : '';
      const phoneValue = phoneInput ? phoneInput.value.trim() : '';
      const zipValid = new RegExp('^[0-9]{5}(-[0-9]{4})?$').test(zipValue);
      const phoneDigits = phoneValue.replace(new RegExp('[^0-9]', 'g'), '');

      if (zipValue && !zipValid) {
        return 'Please enter a valid ZIP code, like 10019 or 10019-1234.';
      }

      if (phoneValue && phoneDigits.length !== 10) {
        return 'Please enter a valid 10-digit phone number, like 555-123-4567.';
      }

      return null;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const error = validateForm();

      if (error) {
        formMessage.textContent = error;
        formMessage.className = 'form-message error';
        formMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      hasSubmittedFinal = true;
      clearTimeout(partialSaveTimer);
      const payload = getFormDataObject('final');
      payload.remove_partial_for_session = true;
      console.log('Final survey payload:', payload);

      submitButton.disabled = true;
      submitButton.textContent = 'Submitting...';

      try {
        await sendToSheets(payload);
      } catch (error) {
        formMessage.textContent = 'Something went wrong while submitting. Please try again.';
        formMessage.className = 'form-message error';
        submitButton.disabled = false;
        submitButton.textContent = 'Submit survey';
        return;
      }

      localStorage.removeItem('riordanSurveySessionId');

      document.querySelectorAll('.question-card').forEach(card => card.classList.add('hide'));
      document.getElementById('intro').classList.add('hide');
      formMessage.className = 'form-message';
      successScreen.classList.add('show');
      launchConfetti();
      actionsBar.classList.add('hide');
      progressBar.style.width = '100%';
      progressText.textContent = '100% complete';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</body>
</html>
